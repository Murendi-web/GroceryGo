# Copy to .env and fill in. Restart `npx expo start` after changing it.
# Leave all three empty to run in demo mode (no sync, no AI).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
EXPO_PUBLIC_AI_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/ai-chat
